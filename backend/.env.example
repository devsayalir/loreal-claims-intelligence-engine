DATABASE_URL="postgresql://claims:claims@localhost:5433/claims?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173

# openai | mock. Falls back to mock when OPENAI_API_KEY is empty.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
# Log full prompts and model responses (contains study data, dev only).
LOG_LLM_PAYLOADS=false
